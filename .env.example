# AWS Route 53 Domains uses us-east-1.
AWS_REGION=us-east-1

# NS1 API Key
NS1_APIKEY=

# Project the Cloud DNS zones and the apex health check live in.
# The google provider reads GOOGLE_PROJECT first, then GOOGLE_CLOUD_PROJECT.
GOOGLE_CLOUD_PROJECT=
GOOGLE_PROJECT=

# Project and account gcloud itself operates as, kept in step with the above so
# `gcloud auth application-default login` grants credentials for the same place.
CLOUDSDK_CORE_PROJECT=
CLOUDSDK_CORE_ACCOUNT=
