# AWS Route 53 Domains uses us-east-1.
AWS_REGION=us-east-1

NS1_APIKEY=

# Every Cloud DNS zone and health check except the tsujiura.ogadra.net zone lives in this project.
GOOGLE_CLOUD_PROJECT=
GOOGLE_PROJECT=

# Match these to the project above and to the account used for application-default login.
CLOUDSDK_CORE_PROJECT=
CLOUDSDK_CORE_ACCOUNT=
